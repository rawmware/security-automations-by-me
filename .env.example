# Copy to .env and fill in. Never commit the real .env.
# Every secret in automations.yaml can reference these via ${VAR_NAME}.

# --- Alerting ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Email alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Optional threat-intel API keys (all optional; automations degrade gracefully) ---
# URLSCAN_API_KEY=      # raises urlscan.io rate limits; search API works without it
